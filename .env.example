APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Evidence storage: "public" (local disk, permanent URLs) for local dev,
# "r2" (Cloudflare R2, private + short-lived signed URLs) for staging/prod.
EVIDENCE_DISK=public
EVIDENCE_URL_TTL_MINUTES=15

# Cloudflare R2 (S3-compatible). Only needed when EVIDENCE_DISK=r2.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Indonesian national holiday API (api.co.id), used by `holidays:sync`.
HOLIDAY_API_BASE_URL=https://use.api.co.id
HOLIDAY_API_TOKEN=

# OpenAI vision evidence assessment (Phase 11).
AI_EVIDENCE_ENABLED=true
OPENAI_API_KEY=
OPENAI_EVIDENCE_MODEL=gpt-5-nano

VITE_APP_NAME="${APP_NAME}"

# Comma-separated frontend origins allowed to call this API cross-origin.
# Leave as "*" for local dev; set to the real frontend domain(s) in production.
CORS_ALLOWED_ORIGINS=*

# How long an issued API token stays valid (Sanctum). Default: 7 days.
SANCTUM_TOKEN_EXPIRATION_MINUTES=10080

# Used ONLY by `php artisan db:seed --class=ProductionSeeder` to create the
# first real SuperAdmin account on a fresh deployment. Set these on the
# server before running it, then leave them (the seeder is a no-op once a
# SuperAdmin already exists).
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
